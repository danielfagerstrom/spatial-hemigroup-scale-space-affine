@misc{fagerstrom2026cone,
	title = {Spatial scale space from hemigroup axioms: the admissible cone, its corners and their implementation},
	copyright = {Creative Commons Attribution 4.0 International},
	doi = {10.5281/zenodo.22864170},
	abstract = {Gaussian scale space is the classical answer to the question of which smoothing kernels can serve a multi-scale representation. A companion paper showed that on the line the answer is much larger when the semigroup requirement of the axioms is weakened to a cascade, a two-parameter hemigroup: the admissible kernels are the symmetric self-decomposable laws, each given by a Gaussian coefficient and a nonincreasing profile of displacement sizes. This paper describes that class for a reader who computes with it, in three steps. The first is its shape. The admissible exponents form a convex cone in which every member is a unique superposition of the Gaussian and the members whose profile is a unit step. Subordination maps the time-causal scale spaces of the same axioms injectively into the cone, and the image consists of the members whose radial extension is self-decomposable in every dimension. The second is the familiar families in it: the Matérn kernels of spatial statistics, the Student-t laws and the symmetric stable laws are located and compared by their moments, their tails and their behaviour at the origin. The third is computation. For signals on the line the cascade composes exactly over any finite set of scales, and the Matérn families of integer index are exactly those whose stages are cascades of identical first-order recursive filters, run forward and backward. The families computed in this way do not reach the stable members even in the limit, and the sampling of the signal is a separate approximation. A numerical example checks the statements and finds that the continuous prototypes of two recursive Gaussian filters in common use are the kernels of no such cascade. Locality and the non-creation of local extrema are outside the paper. Most of the results of the first two steps are machine-checked in Lean 4, and those of the third are proved in prose.
This deposit is the article's verification export: the PDF, its LaTeX source, the Lean 4 modules its statements rest on, the trust boundary with the ledger of cited facts, the blueprint chapters, the process account and the external reviews.},
	publisher = {Zenodo},
	author = {Fagerström, Daniel},
	month = sep,
	year = {2026},
	note = {version 0.1},
}

@misc{fagerstrom2026isotropic,
	title = {Spatial scale space from hemigroup axioms: rotation-invariant self-decomposable kernels in dimension d},
	copyright = {Creative Commons Attribution 4.0 International},
	doi = {10.5281/zenodo.23357468},
	abstract = {Scale-space axioms usually require the cascade to be a semigroup, which with rotation and scale invariance leads to Gaussian and stable kernels. The axioms studied here require only that the stages compose, a hemigroup indexed by two scales, and that rescaling the signal relabels the scales. This paper derives the rotation-invariant families they allow in ℝ{\textasciicircum}d. The kernels that take the signal to each scale are the dilations of one rotation-invariant law that is self-decomposable: the convolution of each contracted copy of itself with another law. Every such law but the point mass occurs. Suitably labelled, the kernel at scale t has Fourier transform e{\textasciicircum}\{-F(t{\textbar}ξ{\textbar})\}, for one function F. Its density is bounded near the centre exactly when c {\textgreater} d, where c ≤ ∞ is the power at which the transform falls off. Otherwise a point source is recorded as a spike, whose growth and constant are given. For finite c a stage between positive scales passes a fixed fraction of the record unchanged. Since c depends on F alone, a kernel bounded on the line can have a spike in the plane: the Matérn kernels of the Bessel scale space, with transform (1 + {\textbar}ξ{\textbar}{\textasciicircum}2/2){\textasciicircum}\{-γ\}, do for 1/2 {\textless} γ ≤ 1. Each higher dimension allows strictly fewer F. An allowed F(r) ∼ c log r determines a radial characteristic function, the Fourier transform of a law, and is allowed in ℝ{\textasciicircum}\{d+1\} exactly when that function is a characteristic function there. The statements are machine-checked in Lean 4, assuming seven theorems of the literature, except those that § 1.1 lists as proved in print.
This deposit is the article's verification export: the PDF, its LaTeX source, the Lean 4 modules its statements rest on, the trust boundary with the ledger of cited facts, the blueprint chapters, the process account and the external reviews.},
	publisher = {Zenodo},
	author = {Fagerström, Daniel},
	month = oct,
	year = {2026},
	note = {version 0.1},
}

@misc{fagerstrom2026spatial,
	title = {Spatial scale space from hemigroup axioms: characterization of the kernels on the line},
	doi = {10.5281/zenodo.22761632},
	abstract = {We characterize the spatial scale spaces on the line: the families of smoothing operators through which an uncommitted observer can measure a signal at every scale, under translation and reflection symmetry. The axioms are those of the extended class of Pauwels, Van Gool, Fiddelaers and Moons, with one weakened. Their recursivity, a one-parameter semigroup in scale, is stated as a two-parameter hemigroup Phi\_\{s,t\} Phi\_\{r,s\} = Phi\_\{r,t\}, which retains the composition of measurements and drops the tacit assumption that an increment depends only on the scale difference, the stationarity of the increments in the scale parameter. Two things then change. Without positivity no classification of the form proved here exists: the remaining axioms admit an infinite-dimensional family containing the Gaussian. With positivity the admissible kernels from the origin are exactly the symmetric self-decomposable laws. Each family is determined by a Gaussian coefficient and a nonincreasing function that sets the rate of displacements at every size. The Gaussian families form the one ray with a Gaussian coefficient alone, an extreme ray of the cone rather than the whole of it. Reimposing stationarity, in whichever scale parametrization the family has it, selects the symmetric stable family, the positive part of the extended class, with the bound α ≤ 2 proved from the representation. The class also contains members with all moments finite, the variance-gamma family among them, whose kernels are the Matérn covariance functions for smoothness above zero. The kernels from the origin are absolutely continuous and unimodal. The contribution is the derivation of this class from measurement axioms on the line; locality, non-creation of local extrema, recursive implementation and higher dimension are outside the paper. The characterization is machine-checked in Lean 4, resting on two cited analytic facts, Bochner's theorem and the symmetric Lévy–Khintchine representation; the regularity of the kernels rests on two more.},
	publisher = {Zenodo},
	author = {Fagerström, Daniel},
	month = sep,
	year = {2026},
	note = {version 0.1},
}

